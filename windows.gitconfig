[user]
  email = parkersnell@gmail.com
  name = Parker Snell
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[core]
  symlinks = true
  autocrlf = input
  filemode = false
  eol = lf
[pull]
  rebase = true
[init]
  defaultBranch = master
[credential]
	helper = manager
